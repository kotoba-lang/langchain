{:paths ["src"]
 ;; Zero THIRD-PARTY runtime dependencies by design (ADR-0001): every namespace
 ;; is .cljc and runs on JVM Clojure, ClojureScript, SCI, and Clojure-on-WASM.
 ;; The one dep is the sibling kotoba-lang/json (first-party, zero-dep) — the
 ;; in-language JSON parser that replaces the old host-injected seam. langchain
 ;; is a consumer of kotoba-lang/json (a real vertical lib depending on a
 ;; foundational-stdlib lib; M5 for json).
 ;;
 ;; langchain.jvm (the http-kit/jsonista host-fn reference impl) is JVM-only
 ;; (behind #?(:clj ...) reader conditionals) and intentionally does NOT pull
 ;; http-kit/jsonista into the main :deps -- that would break the zero-dep
 ;; promise for every SCI/WASM/CLJS consumer of the pure core. Consumers of
 ;; langchain.jvm bring their own http-kit/jsonista (every current one
 ;; already does, for its own server needs); the :test alias supplies them
 ;; for this repo's own tests.
 ;; Bumped past json#1 (decode's number parsing now validates RFC 8259
 ;; grammar before parsing -- was silently misparsing malformed numbers
 ;; on :cljs) and its own control-character-escaping fix -- both
 ;; directly consequential here since langchain.json wraps this
 ;; decode/encode as langchain's default JSON codec.
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/json {:git/sha "f6a534458ddfcb88e5e03facb35ebf61902e1bc4"}
        io.github.kotoba-lang/edn
        {:git/url "https://github.com/kotoba-lang/edn.git"
         :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      ;; langchain.jvm-test exercises the JVM :clj branch
                      http-kit/http-kit {:mvn/version "2.8.0"}
                      metosin/jsonista  {:mvn/version "0.3.11"}
                      ;; langchain.kotobase-persist-test exercises the
                      ;; ADR-2607150000 db.cljc<->kotobase.store adapter --
                      ;; same optional-dep isolation as http-kit/jsonista
                      ;; above, kept out of the main :deps.
                      io.github.kotoba-lang/kotobase
                      {:git/sha "96dbdaeb27c67d9ede2be01e8b737f52938e2590"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
